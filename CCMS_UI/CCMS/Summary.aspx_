                                                            <tr>
                                                                <td style="background-color: Red">
                                                                </td>
                                                                <td>
                                                                    <b>ATMs With No Activity</b>
                                                                </td>
                                                                <td>
                                                                    <asp:Label ID="Label_NoActivity" runat="server" Font-Bold="true" Text="1200"></asp:Label>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td valign="top" style="width: 10%">
                                                        <asp:Chart ID="Chart3" runat="server" Width="425" EnableViewState="true">
                                                            <Titles>
                                                                <asp:Title Font="Trebuchet MS, 14.25pt, style=Bold" Name="Title1" ForeColor="26, 59, 105"
