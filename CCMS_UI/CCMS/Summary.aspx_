                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td style="background-color: Orange">
                                                                </td>
                                                                <td>
                                                                    <b>ATMs Cassettes Faulty</b>
                                                                </td>
                                                                <td>
                                                                    <asp:Label ID="Label_CassettesFaulty" runat="server" Font-Bold="true" Text="10990"></asp:Label>
