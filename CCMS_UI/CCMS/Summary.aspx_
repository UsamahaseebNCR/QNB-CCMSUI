                                                    <AlternatingRowStyle BackColor="#eff0ef" />
                                                    <Columns>
                                                        <asp:BoundField DataField="Activity" HeaderText="Activity" />
                                                        <asp:BoundField DataField="Count" HeaderText="Count" ItemStyle-HorizontalAlign="Right" />
                                                    </Columns>
                                                    <EmptyDataTemplate>
                                                        No records found
                                                    </EmptyDataTemplate>
                                                </asp:GridView>
                                            </div>
                                        </td>
                                    </tr>
                                </table>
